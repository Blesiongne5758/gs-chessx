# Copy to /etc/turnserver.conf on a TURN host with a public/reachable IP.
# Replace every <...> placeholder. Never commit the real secret or private key.
listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret
static-auth-secret=<GENERATE_A_RANDOM_SECRET_AND_SET_THE_SAME_VALUE_IN_SUPABASE_EDGE_FUNCTION_SECRETS>
realm=<turn.your-domain.example>
server-name=<turn.your-domain.example>
external-ip=<PUBLIC_IPV4_ADDRESS>
min-port=49160
max-port=49200
cert=/etc/letsencrypt/live/<turn.your-domain.example>/fullchain.pem
pkey=/etc/letsencrypt/live/<turn.your-domain.example>/privkey.pem
no-multicast-peers
no-cli
no-loopback-peers
